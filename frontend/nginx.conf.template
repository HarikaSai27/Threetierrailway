server {
  listen ${PORT};
  listen [::]:${PORT};

  root /usr/share/nginx/html;
  index index.html;

  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  location / {
    try_files $uri $uri/ /index.html;
  }

  # Proxy API calls to the backend tier. Using a variable makes nginx resolve
  # the hostname at request time, so it still starts if the backend isn't up yet.
  location /api/ {
    set $backend "${BACKEND_URL}";
    proxy_pass $backend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }
}
